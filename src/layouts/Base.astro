---
import "../styles/global.css";
import MermaidDiagrams from "../components/MermaidDiagrams.astro";
import ImageLightbox from "../components/ImageLightbox.astro";
import ApexCharts from "../components/ApexCharts.astro";

interface Props {
  title: string;
  description?: string;
  // Widens the main column (e.g. the admin editor's side-by-side panes).
  wide?: boolean;
}

const {
  title,
  description = "ieg archive — notes on software",
  wide = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a href="/" class="site-title" aria-label="ieg archive — home">
          ieg archive
        </a>
        <nav class="site-nav" aria-label="Social links">
            <a
              href="https://github.com/ivan-guerra"
              target="_blank"
              rel="noopener"
              aria-label="GitHub"
            >
              <svg viewBox="0 0 16 16" width="18" height="18" fill="currentColor" aria-hidden="true">
                <path
                  d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
                ></path>
              </svg>
            </a>
          </nav>
      </div>
    </header>

    <main class:list={["wrap", { wide }]}>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <span>© {new Date().getFullYear()} Adam Williams</span>
        <span>built on <a href="https://github.com/jumploops/.com">astro</a></span>
      </div>
    </footer>

    <MermaidDiagrams />
    <ApexCharts />
    <ImageLightbox />

    <script>
      // Blinking-cursor animation on the site title (respects prefers-reduced-motion).
      {
        const noMotion = window.matchMedia(
          "(prefers-reduced-motion: reduce)"
        ).matches;
        if (!noMotion) {
          const titleEl = document.querySelector<HTMLElement>(".site-title");
          if (titleEl) {
            titleEl.classList.add("site-title--animated");
          }
        }
      }
    </script>
  </body>
</html>
