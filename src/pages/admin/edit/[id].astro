---
import { env } from "cloudflare:workers";
import Base from "../../../layouts/Base.astro";
import { getDraft } from "../../../lib/drafts";
import "../../../styles/admin.css";

export const prerender = false;

const draft = await getDraft((env as any).DRAFTS, Astro.params.id!);
if (!draft) {
  return new Response("Draft not found.", { status: 404 });
}
---

<Base title="edit — jumploops" wide>
  <div class="editor-bar">
    <div class="group">
      <a class="admin-btn secondary" href="/admin">← admin</a>
      <input
        class="slug-input"
        id="slug"
        value={draft.slug}
        spellcheck="false"
        aria-label="Post slug"
      />
      <span class="save-status" id="status">saved</span>
    </div>
    <div class="group">
      <button class="admin-btn danger" id="delete">delete</button>
      <button class="admin-btn" id="publish">publish</button>
    </div>
  </div>

  <div class="editor-tabs" role="tablist">
    <button class="editor-tab" id="tab-code" role="tab" aria-selected="true">
      code
    </button>
    <button
      class="editor-tab"
      id="tab-preview"
      role="tab"
      aria-selected="false"
    >
      preview
    </button>
  </div>

  <div class="editor-layout">
    <div class="editor-cell hidden" id="cell-preview">
      <iframe
        id="preview"
        title="Post preview"
        data-src={`/admin/preview/${draft.id}`}></iframe>
    </div>
    <div class="editor-cell" id="cell-code">
      <textarea id="content" spellcheck="false">{draft.content}</textarea>
    </div>
  </div>

  <script>
    import { createScrollSync } from "../../../lib/scroll-sync";

    const draftId = location.pathname.split("/").pop()!;
    const textarea = document.getElementById("content") as HTMLTextAreaElement;
    const slugInput = document.getElementById("slug") as HTMLInputElement;
    const status = document.getElementById("status")!;
    const tabCode = document.getElementById("tab-code")!;
    const tabPreview = document.getElementById("tab-preview")!;
    const cellCode = document.getElementById("cell-code")!;
    const cellPreview = document.getElementById("cell-preview")!;
    const preview = document.getElementById("preview") as HTMLIFrameElement;

    // Wide viewports show code and preview side-by-side (tabs hidden via
    // CSS); narrow ones keep the tab switcher. Keep in sync with the
    // media query in admin.css.
    const wide = window.matchMedia("(min-width: 1200px)");

    let timer: number | undefined;
    let saving: Promise<void> | null = null;
    let dirty = false;

    // ---- preview lifecycle ----
    // The iframe loads /admin/preview/[id] once; after that, each
    // successful save posts a message and the preview swaps in a freshly
    // rendered fragment in place (no reload, scroll and unchanged
    // diagrams/charts survive).
    let previewLoaded = false;
    let previewReady = false;
    let pendingRefresh = false;
    let healAttempts = 0;
    let lastHealAt = 0;
    let healRetryTimer: number | undefined;

    // Scrolling either pane scrolls the other to the same source
    // position (only meaningful side-by-side, so gated on `wide`).
    const sync = createScrollSync(textarea, preview, () => wide.matches);

    window.addEventListener("message", (e) => {
      if (e.origin === location.origin && e.data?.type === "preview-refreshed") {
        sync.previewRefreshed();
      }
    });

    const loadPreview = () => {
      if (previewLoaded) return;
      previewLoaded = true;
      preview.src = preview.dataset.src!;
    };

    const refreshPreview = () => {
      if (!previewLoaded) return;
      if (!previewReady) {
        // Preview is broken or mid-(re)load. If we gave up healing it,
        // let a successful save schedule one retry — at most one
        // reload per 15s, however often saves come in.
        if (healAttempts > 3) {
          clearTimeout(healRetryTimer);
          const wait = Math.max(0, 15000 - (Date.now() - lastHealAt));
          healRetryTimer = window.setTimeout(() => {
            healAttempts = 0;
            reloadPreview();
          }, wait);
        }
        pendingRefresh = true;
        return;
      }
      preview.contentWindow?.postMessage(
        { type: "refresh-preview" },
        location.origin
      );
    };

    const reloadPreview = () => {
      previewReady = false;
      lastHealAt = Date.now();
      preview.src = preview.dataset.src!;
    };

    preview.addEventListener("load", () => {
      // The frame can land somewhere without #preview-root two ways: a
      // link inside the preview navigated it away (or cross-origin,
      // where contentDocument is null), or the server answered with an
      // error page (e.g. a 503 when the worker is over its limits).
      // Restore it with backoff and give up after a few tries — an
      // immediate unconditional reload here turns a persistent error
      // into a reload storm that hammers the worker.
      if (!preview.contentDocument?.getElementById("preview-root")) {
        previewReady = false;
        healAttempts++;
        if (healAttempts <= 3) {
          setTimeout(reloadPreview, healAttempts * 2000);
        } else {
          status.textContent = "preview unavailable";
        }
        return;
      }
      healAttempts = 0;
      previewReady = true;
      sync.previewLoaded();
      if (pendingRefresh) {
        pendingRefresh = false;
        refreshPreview();
      }
    });

    // ---- saving ----
    const save = async () => {
      status.textContent = "saving…";
      dirty = false;
      saving = fetch(`/admin/api/drafts/${draftId}`, {
        method: "PUT",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          content: textarea.value,
          slug: slugInput.value,
        }),
      })
        .then((res) => {
          status.textContent = res.ok ? "saved" : "save failed";
          if (res.ok) refreshPreview();
        })
        .catch(() => {
          status.textContent = "save failed";
        })
        .finally(() => {
          saving = null;
        });
      await saving;
    };

    const scheduleSave = () => {
      status.textContent = "…";
      dirty = true;
      clearTimeout(timer);
      timer = window.setTimeout(save, 800);
    };

    textarea.addEventListener("input", scheduleSave);
    textarea.addEventListener("input", () => sync.contentChanged());
    slugInput.addEventListener("input", scheduleSave);

    // Tab inserts two spaces instead of leaving the textarea.
    textarea.addEventListener("keydown", (e) => {
      if (e.key === "Tab") {
        e.preventDefault();
        const { selectionStart, selectionEnd, value } = textarea;
        textarea.value =
          value.slice(0, selectionStart) + "  " + value.slice(selectionEnd);
        textarea.selectionStart = textarea.selectionEnd = selectionStart + 2;
        scheduleSave();
      }
    });

    // ---- layout: tabs (narrow) / side-by-side (wide) ----
    const setTab = (mode: "code" | "preview") => {
      tabCode.setAttribute("aria-selected", String(mode === "code"));
      tabPreview.setAttribute("aria-selected", String(mode === "preview"));
      cellCode.classList.toggle("hidden", mode !== "code");
      cellPreview.classList.toggle("hidden", mode !== "preview");
    };

    tabCode.addEventListener("click", () => setTab("code"));
    tabPreview.addEventListener("click", async () => {
      setTab("preview");
      clearTimeout(timer);
      await save();
      loadPreview();
    });

    const applyLayout = async () => {
      if (!wide.matches) return;
      sync.layoutChanged();
      if (dirty) {
        clearTimeout(timer);
        await save();
      }
      loadPreview();
    };

    wide.addEventListener("change", applyLayout);
    applyLayout();

    // ---- publish / delete ----
    document.getElementById("publish")!.addEventListener("click", async () => {
      if (!confirm(`Publish "${slugInput.value}" to the live site?`)) return;
      clearTimeout(timer);
      await save();
      status.textContent = "publishing…";
      const res = await fetch(`/admin/api/publish/${draftId}`, {
        method: "POST",
      });
      const result = await res.json();
      if (!res.ok) {
        status.textContent = "publish failed";
        alert(result.error ?? "Publish failed.");
        return;
      }
      alert(
        `Published! The deploy is building now — the post will be live at ${result.postUrl} shortly.`
      );
      location.href = "/admin";
    });

    document.getElementById("delete")!.addEventListener("click", async () => {
      if (!confirm("Delete this draft?")) return;
      await fetch(`/admin/api/drafts/${draftId}`, { method: "DELETE" });
      location.href = "/admin";
    });
  </script>
</Base>
