---
import { env } from "cloudflare:workers";
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import { listDrafts } from "../../lib/drafts";
import { splitFrontmatter } from "../../lib/frontmatter";
import "../../styles/admin.css";

export const prerender = false;

const drafts = await listDrafts((env as any).DRAFTS);
const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const draftTitle = (content: string, slug: string) =>
  splitFrontmatter(content).data.title || slug;

const fmtWhen = (ts: number) =>
  new Date(ts).toLocaleString("en-US", {
    month: "short",
    day: "numeric",
    hour: "numeric",
    minute: "2-digit",
    timeZone: "America/Los_Angeles",
  });
---

<Base title="admin — jumploops’ blog">
  <section class="intro">
    <h1>admin</h1>
    <p>drafts live here until published; publishing commits to github.</p>
  </section>

  <section class="admin-section">
    <div class="editor-bar">
      <h2>drafts</h2>
      <button class="admin-btn" id="new-draft">+ new post</button>
    </div>
    {
      drafts.length === 0 ? (
        <p class="item-meta">no drafts yet.</p>
      ) : (
        <ul class="admin-list">
          {drafts.map((d) => (
            <li class="admin-item">
              <a class="item-title" href={`/admin/edit/${d.id}`}>
                {draftTitle(d.content, d.slug)}
              </a>
              <span class="item-meta">
                {d.slug} · saved {fmtWhen(d.updatedAt)}
              </span>
            </li>
          ))}
        </ul>
      )
    }
  </section>

  <section class="admin-section">
    <h2>published</h2>
    <ul class="admin-list">
      {
        posts.map((post) => (
          <li class="admin-item">
            <a class="item-title" href={`/blog/${post.id}/`} target="_blank">
              {post.data.title}
            </a>
            <span class="group">
              <span class="item-meta">{post.id}</span>
              <button class="admin-btn secondary edit-post" data-id={post.id}>
                edit
              </button>
            </span>
          </li>
        ))
      }
    </ul>
  </section>

  <script>
    const create = async (payload: Record<string, string>) => {
      const res = await fetch("/admin/api/drafts", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });
      if (!res.ok) {
        alert("Failed to create draft.");
        return;
      }
      const draft = await res.json();
      location.href = `/admin/edit/${draft.id}`;
    };

    document
      .getElementById("new-draft")
      ?.addEventListener("click", () => create({}));

    for (const btn of document.querySelectorAll<HTMLButtonElement>(
      ".edit-post"
    )) {
      btn.addEventListener("click", () =>
        create({ fromPost: btn.dataset.id! })
      );
    }
  </script>
</Base>
