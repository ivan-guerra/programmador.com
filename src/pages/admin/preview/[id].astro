---
import { env } from "cloudflare:workers";
import { getDraft } from "../../../lib/drafts";
import { splitFrontmatter } from "../../../lib/frontmatter";
import { renderMarkdown } from "../../../lib/markdown";
import MermaidDiagrams from "../../../components/MermaidDiagrams.astro";
import "../../../styles/global.css";

export const prerender = false;

const draft = await getDraft((env as any).DRAFTS, Astro.params.id!);
if (!draft) {
  return new Response("Draft not found.", { status: 404 });
}

const { data, body } = splitFrontmatter(draft.content);
const html = await renderMarkdown(body);

const title = data.title ?? draft.slug;
const pubDate = data.pubDate ?? new Date();
const tags = data.tags ?? [];

// Article markup identical to src/pages/blog/[id].astro, but without the
// site chrome (header/footer/circles) — this renders inside the editor's
// preview iframe.
const formatDate = (date: Date) =>
  date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
    timeZone: "UTC",
  });
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{title} — preview</title>
  </head>
  <body>
    <main class="wrap">
      <article>
        <header class="article-header">
          <a href="/" class="back-link">← back</a>
          <div class="post-meta">
            <time datetime={pubDate.toISOString()}>
              {formatDate(pubDate)}
            </time>
            {tags.map((tag) => <span class="tag">{tag}</span>)}
          </div>
          <h1>{title}</h1>
        </header>
        <div class="prose" set:html={html} />
      </article>
    </main>
    <MermaidDiagrams />
  </body>
</html>
