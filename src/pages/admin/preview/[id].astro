---
import { env } from "cloudflare:workers";
import { getDraft } from "../../../lib/drafts";
import { renderDraftArticle } from "../../../lib/preview";
import MermaidDiagrams from "../../../components/MermaidDiagrams.astro";
import ImageLightbox from "../../../components/ImageLightbox.astro";
import ApexCharts from "../../../components/ApexCharts.astro";
import "../../../styles/global.css";

export const prerender = false;

const draft = await getDraft((env as any).DRAFTS, Astro.params.id!);
if (!draft) {
  return new Response("Draft not found.", { status: 404 });
}

// Article markup shared with the live-refresh endpoint; without the site
// chrome (header/footer/circles) — this renders inside the editor's
// preview iframe.
const { title, article } = await renderDraftArticle(draft);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{title} — preview</title>
  </head>
  <body>
    <main class="wrap" id="preview-root" set:html={article} />
    <div class="preview-error" id="preview-error" hidden></div>
    <MermaidDiagrams />
    <ApexCharts />
    <ImageLightbox />

    <script>
      // Live refresh: the editor posts a message after each successful
      // save; we fetch the freshly rendered article fragment and swap it
      // in place, so scroll position survives and unchanged mermaid/apex
      // figures are adopted (see the upgrade functions) instead of
      // re-rendered.
      const draftId = location.pathname.split("/").pop()!;
      const root = document.getElementById("preview-root")!;
      const errEl = document.getElementById("preview-error")!;

      let lastFragment: string | null = null;
      let refreshing = false;
      let queued = false;

      const refresh = async () => {
        if (refreshing) {
          queued = true;
          return;
        }
        refreshing = true;
        try {
          const res = await fetch(`/admin/api/render/${draftId}`, {
            cache: "no-store",
          });
          if (!res.ok) throw new Error(await res.text());
          const fragment = await res.text();
          errEl.hidden = true;
          if (fragment !== lastFragment) {
            lastFragment = fragment;
            const scrollY = window.scrollY;
            root.innerHTML = fragment;
            await (window as any).upgradeMermaid?.(root);
            await (window as any).upgradeApexCharts?.(root);
            (window as any).upgradeLightbox?.(root);
            window.scrollTo(0, scrollY);
            // Tell the editor the layout changed (it keeps scroll-sync
            // anchors for our elements).
            parent.postMessage({ type: "preview-refreshed" }, location.origin);
          }
        } catch (err) {
          errEl.textContent = `preview stale — ${
            err instanceof Error ? err.message : String(err)
          }`;
          errEl.hidden = false;
        } finally {
          refreshing = false;
          if (queued) {
            queued = false;
            refresh();
          }
        }
      };

      window.addEventListener("message", (e) => {
        if (e.origin === location.origin && e.data?.type === "refresh-preview") {
          refresh();
        }
      });
    </script>

    <style>
      .preview-error {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 10;
        font-family: var(--font-mono);
        font-size: 0.8rem;
        color: #141414;
        background: var(--accent-danger, #f49bab);
        border-bottom: 2.5px solid var(--border);
        padding: 0.4rem 0.8rem;
        white-space: pre-wrap;
      }
    </style>
  </body>
</html>
