---
import { getCollection, render } from "astro:content";
import Base from "../layouts/Base.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// Posts longer than this (markdown source chars) are clamped with a
// "read more" link to the full post.
const CLAMP_THRESHOLD = 800;

const entries = await Promise.all(
  posts.map(async (post) => {
    const { Content } = await render(post);
    return { post, Content, clamped: (post.body?.length ?? 0) > CLAMP_THRESHOLD };
  })
);

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
    timeZone: "UTC",
  });
---

<Base title="jumping loops">
  <div class="post-feed">
    {
      entries.map(({ post, Content, clamped }) => (
        <article class="post-entry">
          <header>
            <div class="post-meta">
              <time datetime={post.data.pubDate.toISOString()}>
                {formatDate(post.data.pubDate)}
              </time>
              {post.data.tags.map((tag) => (
                <span class="tag">{tag}</span>
              ))}
            </div>
            <h2>
              <a href={`/blog/${post.id}/`}>{post.data.title}</a>
            </h2>
          </header>
          <div class={`prose entry-body${clamped ? " entry-clamped" : ""}`}>
            <Content />
          </div>
          {clamped && (
            <a class="read-more" href={`/blog/${post.id}/`}>
              expand more →
            </a>
          )}
        </article>
      ))
    }
  </div>
</Base>
