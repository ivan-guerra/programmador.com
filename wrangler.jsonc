{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jumploops-com",
  "compatibility_date": "2026-07-14",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/admin", "/admin/*"]
  },
  "kv_namespaces": [
    {
      "binding": "DRAFTS",
      "id": "066f9739496b43a891899843778b2886"
    },
    {
      "binding": "SESSION",
      "id": "f3f831359b7f46f5812a530b8890b59c"
    }
  ],
  "vars": {
    "GITHUB_REPO": "jumploops/.com"
  }
}
